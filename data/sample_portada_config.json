  "emission_sources": [
    {
      "id": 1,
      "name": "Tanque de Relevo",
      "description": "Almacenamiento intermedio y regulador en estaciones de bombeo, con tiempos de retención más cortos.",
      "photo_path": "assets/fuente1.jpg"
    },
    {
      "id": 2,
      "name": "Generador Eléctrico",
      "description": "Un generador eléctrico es una máquina que convierte energía mecánica en energía eléctrica mediante el principio de inducción electromagnética. Generalmente está compuesto por un motor de combustión interna, que utiliza combustibles como diésel, gas o gasolina, y un alternador que transforma el movimiento en corriente eléctrica.",
      "photo_path": "assets/fuente2.jpg"
    },
    {
      "id": 3,
      "name": "Tramo vial Estación Chimita",
      "description": "Tramo de infraestructura de transporte que conecta la estación Chimita, con sus diferentes áreas productivas.",
      "photo_path": "assets/fuente3.jpg"
    },
    {
      "id": 4,
      "name": "Descargadero Combustible",
      "description": "En un descargadero de combustible, como el que se observa en la foto, la infraestructura está diseñada para recibir hidrocarburos transportados en carrotanques y transferirlos de manera segura hacia tanques de almacenamiento o sistemas de distribución.",
      "photo_path": "assets/fuente4.jpg"
    },
    {
      "id": 5,
      "name": "Trampa de Raspadores",
      "description": "Una trampa de raspadores es una instalación especializada dentro de un sistema de transporte por tuberías (oleoductos, poliductos o gasoductos) que permite la entrada y salida controlada de dispositivos de limpieza e inspección interna, conocidos como pigs o raspadores.",
      "photo_path": "assets/fuente5.jpg"
    },
    {
      "id": 6,
      "name": "Planta de Gas Natural",
      "description": "Una planta de gas natural es una instalación industrial destinada al procesamiento, almacenamiento y distribución de gas natural, con el objetivo de hacerlo apto para su transporte y consumo.",
      "photo_path": "assets/fuente6.jpg"
    },
    {
      "id": 7,
      "name": "Tanque de Almacenamiento de Combustible",
      "description": "Un tanque de almacenamiento de combustible es una estructura industrial diseñada para recibir, guardar y conservar hidrocarburos líquidos como diésel, gasolina o fuel oil, asegurando su disponibilidad para procesos de consumo o distribución.",
      "photo_path": "assets/fuente7.jpg"
    },
    {
      "id": 8,
      "name": "Zona de Acopio de Residuos Industriales",
      "description": "Una zona de acopio de residuos industriales es un espacio destinado al almacenamiento temporal y controlado de desechos generados por procesos productivos, antes de su tratamiento, disposición final o aprovechamiento.",
      "photo_path": "assets/fuente8.jpg"
    }
  ],

